// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
  // Removed URL as it is now configured in prisma.config.ts

}


//////////////////////////////////////////////////
// NEXTAUTH TABLES
//////////////////////////////////////////////////

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String?
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  passwordResetTokens PasswordResetToken[]
  // Agreement to the Terms and the Privacy Policy, given at sign-up (auth/legal.ts).
  legalConsents LegalConsent[]
  novaExtensionConnections NovaExtensionConnection[]

  userProfile UserProfile?
  workoutLogs       WorkoutLog[]
  liftLogs          LiftLog[]
  sorenessLogs      SorenessLog[]
  bodyweightLogs    BodyweightLog[]
  energyLogs        EnergyLog[]
  injuryFlags       InjuryFlag[]
  weeklyReviews     WeeklyReview[]
  creatureEvolutions CreatureEvolution[]
  personalityAssessments PersonalityAssessment[]

  // Billing (packages/api/src/billing). The account pays; every surface
  // (web, Telegram, the extension) is entitled through it.
  billingSubscription BillingSubscription?
  billingTrial        BillingTrial?
}

//////////////////////////////////////////////////
// MESSENGER COMPANION STATE
//////////////////////////////////////////////////

model MessengerUser {
  id                  String   @id @default(cuid())
  platform            String
  platformChatId      String
  displayName         String?
  username            String?
  persona             String   @default("rex")
  tonePreference      String   @default("hard")
  tier                String   @default("free")
  timezone            String?
  preferredCheckInTime String?
  onboardingComplete  Boolean  @default(false)
  onboardingStep       String   @default("not_started")
  onboardingAnswers    Json?
  energyPattern        String?
  corePain             String?  @db.Text
  primaryGoal30d       String?  @db.Text
  goalCategory         String?
  accountabilityStyle  String?
  aspirationWords      String[]
  creatureType         String?
  creatureColor        String?
  creatureName         String?
  intakeComplete         Boolean  @default(false)
  intakeStep             String   @default("not_started")
  intakeAnswers          Json?
  workoutLogPreference   String?  // "live" | "after" — set during post-onboarding activation
  activeModules          String[]

  nextCheckInAt       DateTime?
  checkInIntervalMin  Int?

  // Workout tracking (Rex gym users)
  splitState       Json?
  personalRecords  Json?
  gymStreak        Int      @default(0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  messages         CompanionMessage[]
  memories         MemoryFact[]
  goals            Goal[]
  plans            Plan[]
  deadlines        Deadline[]
  focusSessions    FocusSession[]
  workoutSessions      TelegramWorkoutSession[]
  customReminders      CustomReminder[]
  nutritionLogs        NutritionLog[]
  goalProgressRecords  GoalProgress[]
  bodyweightHistory    BodyweightHistory[]
  realities            UserReality[]
  userFacts            UserFact[]
  behavioralPatterns   BehavioralPattern[]
  novaAcademicProfile  NovaAcademicProfile?

  @@unique([platform, platformChatId])
  @@index([platformChatId])
}

model CompanionMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  text      String   @db.Text
  intent    String?
  emotion   String?
  metadata  Json?
  createdAt DateTime @default(now())

  user             MessengerUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  consolidationJob NovaConsolidationJob?

  @@index([userId, createdAt])
}

model MemoryFact {
  id              String   @id @default(cuid())
  userId          String
  type            String
  key             String
  value           String   @db.Text
  confidence      Float    @default(0.8)
  sourceMessageId String?
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, type])
  @@index([userId, key])
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  title           String   @db.Text
  status          String   @default("active")
  sourceMessageId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Plan {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Deadline {
  id              String   @id @default(cuid())
  userId          String
  title           String   @db.Text
  dueAt           DateTime
  status          String   @default("active")
  sourceMessageId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([dueAt])
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  durationMin Int
  status      String   @default("active")
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

//////////////////////////////////////////////////
// ONBOARDING / AI PROFILE
//////////////////////////////////////////////////

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique

  // 🔹 Core Identity
  primaryDomain      String?
  secondaryDomains   String[]   // Postgres supports arrays

  seriousness        String?

  // 🔹 Psychology
  consistency        String?
  motivationType     String?
  failurePattern     String?
  emotionalTrigger   String?
  riskLevel          String?

  // 🔹 Persona
  primaryPersona     String?
  tone               String?
  toneModifier       String?

  // 🔹 Kevo web onboarding quiz
  energyPattern        String?
  corePain             String?  @db.Text
  primaryGoal30d       String?  @db.Text
  goalCategory         String?
  accountabilityStyle  String?
  aspirationWords      String[]
  personaName          String?
  personaDescription   String?
  creatureType         String?
  creatureColor        String?
  creatureName         String?
  preferredCheckInTime String?
  timezone             String?
  onboardingComplete   Boolean @default(false)
  onboardingAnswers    Json?

  // 🔹 Telegram connection
  telegramConnectToken  String?   @unique
  // A link token is good for a few minutes. A token with no expiry (issued
  // before this column existed) is treated as expired.
  telegramConnectTokenExpiresAt DateTime?
  telegramChatId        String?
  telegramConnected     Boolean   @default(false)
  telegramConnectedAt   DateTime?
  nextMessageTime       DateTime?
  lastMessageSentAt     DateTime?
  lastActivityAt        DateTime?
  messageSchedule       Json?

  // 🔹 Gym (nullable)
  gymMode            Boolean @default(false)
  gymExperience      String?
  gymDaysPerWeek     Int?
  gymPreferredTime   String?

  bench              Int?
  squat              Int?
  deadlift           Int?

  gymGoal            String?
  dietType           String?
  currentSplit       String?
  sessionTime        String?
  phaseWeek          Int     @default(1)
  gymOnboardingComplete Boolean @default(false)
  gymStruggle        String?
  gymEnvironment     String?

  // 🔹 Notification preferences
  browserNotifications   Boolean  @default(true)
  emailDigest            Boolean  @default(true)

  // Mentor intake
  mentorDomain           String?
  mentorIntakeStarted    Boolean  @default(false)
  mentorIntakeComplete   Boolean  @default(false)
  intakeState            Json?

  // How the mentor was chosen (compatibility engine output). The assignment
  // itself is primaryPersona. See packages/api/src/personality.
  mentorMatch            Json?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per completed personality signal (the four onboarding statements).
// A re-run adds a row; the newest complete row is the current signal.
model PersonalityAssessment {
  id                String    @id @default(cuid())
  userId            String
  instrumentVersion String    // e.g. "kivo-signal-v1"
  status            String    @default("complete")
  responses         Json      // raw answers: item id -> 1..5
  scores            Json?     // derived signal; never the raw answers
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WorkoutLog {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  completed       Boolean
  skipReason      String?
  intensityScore  Int?
  energyScore     Int?
  musclesWorked   String[]
  notes           String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  liftLogs LiftLog[]

  @@index([userId, date])
}

model LiftLog {
  id            String  @id @default(cuid())
  userId        String
  workoutLogId  String
  exercise      String
  weightKg      Float
  reps          Int
  sets          Int
  isPR          Boolean @default(false)
  prPrevious    Float?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@index([userId, exercise])
  @@index([workoutLogId])
}

model SorenessLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  muscleGroup String
  score       Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, muscleGroup])
}

model BodyweightLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weightKg  Float
  trend     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model EnergyLog {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  morningScore    Int?
  preSessionScore Int?
  postSessionScore Int?
  sleepHours      Float?
  moodTag         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model InjuryFlag {
  id            String   @id @default(cuid())
  userId        String
  bodyPart      String
  exercise      String?
  reportCount   Int      @default(0)
  active        Boolean  @default(true)
  firstReported DateTime
  lastReported  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([userId, bodyPart])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// One attempt at an email signup that has not been verified yet. The User row
// is created only when the emailed code is confirmed, so these rows are the
// whole of an unfinished registration. An address can have several attempts
// at once (one per browser that started one); none can read or change
// another, because each is reached only through its own token.
// tokenHash and codeHash are hashes; the token and the code are never stored.
// attempts counts wrong codes for the life of the attempt, across resends.
model PendingSignup {
  id            String   @id @default(cuid())
  email         String
  name          String?
  passwordHash  String
  tokenHash     String   @unique
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int      @default(0)
  // The versions agreed to when the attempt started (auth/legal.ts); copied
  // into LegalConsent when the account is created. Null on an attempt started
  // before agreement was asked for: it can no longer become an account.
  termsVersion   String?
  privacyVersion String?
  consentedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

// One row each time an account agreed to the Terms of Service and acknowledged
// the Privacy Policy: which versions, when, and how (auth/legal.ts). Written
// only by sign-up; removed with the account.
model LegalConsent {
  id             String   @id @default(cuid())
  userId         String
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime
  // "email_signup" | "google_signup"
  method         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Counters behind the auth limits that must hold whoever is asking and across
// restarts: failed sign-ins per address, and emails sent per address. key is
// a hash of the limit's name and the address, so no address is stored here.
model AuthThrottle {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  lastAt      DateTime
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String

  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyReview {
  id                String   @id @default(cuid())
  userId            String
  weekStartDate     DateTime
  summaryText       String   @db.Text
  sessionsCompleted Int?
  sessionsPlanned   Int?
  avgEnergyScore    Float?
  avgSleepHours     Float?
  goalPaceStatus    String?
  topWins           String[]
  focusForNextWeek  String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStartDate])
}

model CreatureEvolution {
  id               String   @id @default(cuid())
  userId           String
  stage            Int
  evolvedAt        DateTime @default(now())
  companionMessage String?  @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, evolvedAt])
}

//////////////////////////////////////////////////
// CORE COMPLIANCE TABLES
//////////////////////////////////////////////////

model Product {
  id          String   @id @default(cuid())

  title       String
  productUrl  String   @unique
  platform    String

  brand       String?
  category    String?
  seller      String?

  imageUrl    String?

  // OCR extracted fields
  mrp                 Float?
  netQuantity         String?
  manufacturerName    String?
  manufacturerAddress String?
  countryOfOrigin     String?
  manufactureDate     String?
  consumerCare        String?

  // OCR raw text
  ocrText     String?  @db.Text

  // Compliance results
  complianceScore Int?
  isCompliant     Boolean?

  // store rule failures
  violations Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScanJob {
  id        String   @id @default(cuid())

  platform  String
  status    String

  totalProducts     Int  @default(0)
  violationsFound   Int  @default(0)

  startedAt DateTime @default(now())
  finishedAt DateTime?
}

//////////////////////////////////////////////////
// TELEGRAM WORKOUT TRACKING (Rex gym users)
//////////////////////////////////////////////////

model CustomReminder {
  id                String   @id @default(cuid())
  userId            String
  messageContext    String   @db.Text
  triggerTime       DateTime
  repeat            Boolean  @default(false)
  repeatTime        String?           // HH:MM for daily-at-time reminders
  repeatIntervalMin Int?              // minutes between fires for interval reminders (every 1h, every 30min, etc.)
  fired             Boolean  @default(false)
  createdAt         DateTime @default(now())

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([triggerTime, fired])
}

model TelegramWorkoutSession {
  id              String   @id @default(cuid())
  messengerUserId String
  date            DateTime @default(now())
  splitDayIndex   Int
  musclesTrained  String[]
  durationMinutes Int?
  totalSets       Int?
  sessionSummary  String?  @db.Text
  completed       Boolean  @default(false)

  user MessengerUser    @relation(fields: [messengerUserId], references: [id], onDelete: Cascade)
  sets TelegramSetLog[]

  @@index([messengerUserId, date])
}

model NutritionLog {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @default(now())
  mealType        String?
  description     String   @db.Text
  proteinEstimate Int?
  notedBy         String   @default("user")
  createdAt       DateTime @default(now())

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model GoalProgress {
  id            String    @id @default(cuid())
  userId        String
  goalType      String    // muscle | fat_loss | strength
  exercise      String    @default("") // "" for bodyweight goals; exercise name for strength

  baselineValue Float
  targetValue   Float?
  unit          String    @default("kg")

  startDate     DateTime  @default(now())
  targetDate    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, goalType, exercise])
  @@index([userId])
}

model TelegramSetLog {
  id           String  @id @default(cuid())
  sessionId    String
  exerciseName String
  setNumber    Int
  reps         Int
  weightKg     Float
  rpe          Int?
  completed    Boolean @default(true)

  session TelegramWorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, exerciseName])
}

model BodyweightHistory {
  id         String   @id @default(cuid())
  userId     String
  weightKg   Float
  recordedAt DateTime @default(now())
  source     String   // "onboarding" | "manual_update" | "passive_capture"

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt(sort: Desc)])
}

model UserReality {
  id             String    @id @default(cuid())
  userId         String
  // Canonical shared vocabulary (SKILL.md §9.2):
  //   "health" | "injury" | "emotional" | "life_constraint" | "academic_constraint" | "training_context"
  category       String
  subtype        String?   // detail within a category, e.g. "travel", "work", "exam"
  fact           String    @db.Text
  confidence     Float     @default(0.8)
  relevanceScore Float     @default(1.0)
  sourceText     String?   @db.Text
  provenance     Json?     // { sources: [{ source, sourceMessageId, observedAt, confidence }] }
  // Lifecycle: ACTIVE   = isActive && expiresAt > now
  //            RESOLVED = resolvedAt set (the user said it ended)
  //            EXPIRED  = !isActive && resolvedAt null (TTL elapsed)
  isActive       Boolean   @default(true)
  expiresAt      DateTime
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, expiresAt])
  @@index([userId, category, isActive])
}

//////////////////////////////////////////////////
// NOVA — ACADEMIC INTELLIGENCE LAYER
//////////////////////////////////////////////////

model NovaAcademicProfile {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  yearOfStudy               Int?
  major                     String?
  institution               String?
  degree                    String?
  targetGpa                 Float?
  goals                     String[]
  preferredStudyTime        String?
  studyStyleNotes           String?
  biggestStruggle           String?
  semesterStartDate         DateTime?
  semesterEndDate           DateTime?
  preferredStudyHoursPerDay Float    @default(3.0)
  // What the learner said they usually have on a normal day, in minutes.
  // null: they have not said. Planning then assumes a figure and says so;
  // the default above is never read as something the learner stated.
  dailyStudyMinutes         Int?
  timezone                  String?
  // What the learner said they have today ("I've only got 30 minutes"), and
  // the local day it was said on. It lapses when that day ends. Written only
  // by product/planning-inputs.ts.
  statedMinutes             Int?
  statedMinutesDay          String?

  // Onboarding state
  onboardingStep            String   @default("not_started")
  onboardingComplete        Boolean  @default(false)

  subjects          NovaSubject[]
  exams             NovaExam[]
  studySessions     NovaStudySession[]
  cognitiveState    NovaCognitiveState?
  learningDNA       NovaLearningDNA?
  proactiveMessages NovaProactiveMessage[]
  notes             NovaNote[]
  masterySnapshots  NovaTopicMasterySnapshot[]
  telegramChannel   NovaTelegramChannel?
  telegramPrompts   NovaTelegramPrompt[]
  learningEvents    NovaLearningEvent[]
  tasks             NovaTask[]
  planOverrides     NovaPlanOverride[]
  dayFlows          NovaDayFlow[]
  mapLayout         NovaMapLayout[]
  calendarEvents    NovaCalendarEvent[]
  workspaces        NovaWorkspace[]
  workspaceDrafts   NovaWorkspaceDraft[]

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model NovaSubject {
  id          String  @id @default(cuid())
  profileId   String
  name        String
  code        String?
  credits     Int?
  subjectType String?   // "core" | "elective" | "lab"
  isWeak      Boolean @default(false)
  isStrong    Boolean @default(false)
  // The subject it sits inside ("Automata" inside "Semester Five"), so the
  // learner arranges their own Knowledge Map. Removing that subject leaves
  // this one on its own.
  parentId    String?
  parent      NovaSubject?  @relation("NovaSubjectGroups", fields: [parentId], references: [id], onDelete: SetNull)
  children    NovaSubject[] @relation("NovaSubjectGroups")

  topics NovaTopicMastery[]
  exams  NovaExam[]
  notes  NovaNote[]
  learningEvents NovaLearningEvent[]
  tasks  NovaTask[]
  calendarEvents NovaCalendarEvent[]

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
  @@index([profileId])
  @@index([parentId])
}

model NovaTopicMastery {
  id        String @id @default(cuid())
  subjectId String
  name      String

  // FSRS-lite state (replaceable — interface is permanent, algorithm is not)
  masteryProbability Float    @default(0.0)
  confidenceReported Float    @default(0.0)
  efFactor           Float    @default(2.5)
  intervalDays       Int      @default(1)
  reviewCount        Int      @default(0)
  lastStudiedAt      DateTime?
  nextReviewAt       DateTime?

  // Set when the learner archives the topic: it leaves their lists and plan,
  // and keeps its row, mastery and history. Null: active. Cleared on restore.
  archivedAt DateTime?

  // A topic can sit inside another topic of the same subject (a unit, its
  // topics, their subtopics), in the order given by position among the
  // topics beside it. Null parent: at the top of its subject. Null position:
  // an older row, in the order it was added. Only a leaf is studied on its
  // own (product/topic-tree.ts): a topic with topics inside it organises them.
  parentId String?
  position Int?
  // null: a topic to learn. "milestone": a stage of work in a project or
  // roadmap, which has tasks and is never studied or reviewed.
  kind     String?
  // What the plan said about it: an explanation and its sources, and for a
  // milestone its effort, goals, exercises, project, done-when and resources.
  details  Json?
  parent   NovaTopicMastery?  @relation("NovaTopicTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NovaTopicMastery[] @relation("NovaTopicTree")

  subject       NovaSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  snapshots     NovaTopicMasterySnapshot[]
  planOverrides NovaPlanOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, name])
  @@index([subjectId])
  @@index([nextReviewAt])
  @@index([parentId])
}

// One row per change the Topic Mastery Engine made to a topic: the value
// before, the value after, and what caused it. It is that engine's own
// record of its writes (updateTopicMastery is the only writer, in the same
// transaction as the change), not a second estimate. Progress reads it;
// nothing else does. A topic changed before this table existed has no rows.
model NovaTopicMasterySnapshot {
  id            String   @id @default(cuid())
  topicId       String
  profileId     String
  source        String   // "session_report" | "conversation_signal"
  sessionId     String?  // the NovaStudySession whose report caused it; null for a conversation observation
  masteryBefore Float?   // null: this write created the topic
  masteryAfter  Float
  confidence    Float    // the 0-1 input the engine was given
  reviewCount   Int      // finished sessions behind the topic after this write
  recordedAt    DateTime

  topic   NovaTopicMastery    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // A session's report moves a topic once. A replay fails here and the
  // mastery write in the same transaction is rolled back with it.
  @@unique([topicId, sessionId])
  @@index([profileId, recordedAt])
  @@index([topicId, recordedAt])
}

model NovaExam {
  id          String   @id @default(cuid())
  profileId   String
  subjectId   String?
  title       String
  examType    String   @default("midterm")
  scheduledAt DateTime
  durationMin Int?

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject NovaSubject?        @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, scheduledAt])
}

model NovaStudySession {
  id               String   @id @default(cuid())
  profileId        String
  subjectId        String?
  topicId          String?
  topicName        String?
  durationMinutes  Int
  activityType     String   @default("review")
  performanceScore Float?
  status           String   @default("completed")
  sessionDate      DateTime @default(now())

  // Interactive session (Step 4)
  currentFocus            String?
  plannedDurationMinutes  Int?
  confusionPoints         String[]
  topicsCompleted         String[]
  energyLevel             String?         // "high" | "medium" | "low"
  focusQuality            String?         // "deep" | "moderate" | "scattered"
  pauseCount              Int      @default(0)
  totalPausedMinutes      Int      @default(0)
  totalPausedSeconds      Int      @default(0)   // exact; totalPausedMinutes is its whole-minute floor
  pausedAt                DateTime?
  executionReport         Json?
  reflectionText          String?

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([profileId, sessionDate])
  @@index([profileId, status])
}

// A note the learner wrote. Learner-owned content, not cognitive state:
// nothing reads it as mastery, memory or reality, and nothing but the
// learner's own save writes `title` or `body`.
// The topic is a name beside the subject, as on NovaStudySession, so a note
// can be about a topic that has no NovaTopicMastery row yet.
model NovaNote {
  id        String  @id @default(cuid())
  profileId String
  subjectId String?
  topicName String?
  title     String
  body      String  @db.Text

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject NovaSubject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, updatedAt])
  @@index([profileId, subjectId])
}

model NovaCognitiveState {
  id        String @id @default(cuid())
  profileId String @unique

  investigationTopic       String?
  investigationHypotheses  String[]
  investigationMissingData String[]
  investigationEvidence    Json?
  investigationAttempts    Int      @default(0)
  investigationStatus      String?
  investigationStartedAt   DateTime?
  investigationUpdatedAt   DateTime?

  followUpChecks   Json?
  reasoningHistory Json?
  stateHistory     Json?

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NovaLearningDNA {
  id        String @id @default(cuid())
  profileId String @unique

  optimalSessionMinutes      Int?
  attentionCurve             String?
  preferredReviewStyle       String?
  retentionBoostTriggers     String[]
  peakStudyHours             String[]
  planAdherenceProfile       String?
  commitmentToCompletionRate Float?
  historicalCalibrationGap   Float?
  calibrationTrend           String?
  overconfidentSubjects      String[]
  underconfidentSubjects     String[]
  dataPointCount             Int     @default(0)
  confidence                 String  @default("low")

  // What the Learning DNA engine concluded the last time a session ended,
  // one entry per signal: its conclusion, how well supported it was, since
  // when, and what it replaced. Bookkeeping for "is this belief changing";
  // the conclusions themselves are always recomputed from sessions.
  // Written only by persistence/learning-dna-store.ts.
  signals                    Json?
  computedAt                 DateTime?

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Nova Proactive Mentor System ──────────────────────────────────────────────
// Tracks every proactive message Nova fires — used for cooldown enforcement
// and deduplication. One record per event fired (approved or suppressed).

model NovaProactiveMessage {
  id             String   @id @default(cuid())
  profileId      String
  eventType      String   // ProactiveType value
  firedAt        DateTime
  cooldownUntil  DateTime // legacy column; nothing reads it. Spacing comes from sent rows.
  priority       Int
  confidence     Float
  approved       Boolean  @default(true)
  suppressReason String?  // legacy rows only: suppressed decisions are no longer stored
  text           String?  @db.Text

  // ── Outbox (proactive/proactive-outbox.ts is the only writer) ──────────────
  // One row per logical occurrence ("nudge:2026-10-06"). The unique key is the
  // claim: only one tick, on one instance, can create it.
  // status: claimed → ready (worded) → sending → sent
  //         sending → failed (retryable) → abandoned
  //         sending → unknown (the process died mid-send; never resent)
  // Rows written before the outbox existed have a null status and key.
  occurrenceKey     String?
  status            String?
  localDay          String?   // YYYY-MM-DD in the learner's timezone
  attempts          Int       @default(0)
  telegramMessageId Int?
  sentAt            DateTime?
  lastError         String?

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, occurrenceKey])
  @@index([profileId, firedAt])
  @@index([profileId, eventType, cooldownUntil])
  @@index([profileId, localDay, status])
  @@index([status, firedAt])
}

// ─── Consolidated durable state ───────────────────────────────────────────────
// Written ONLY by a companion's consolidation layer (SKILL.md §11.7, §16.4).
// Evidence (messages, signals, extractions) never lands here directly.

// Stable semantic facts about the user. Never conversation turns, sessions,
// transient signals or companion control state.
model UserFact {
  id              String   @id @default(cuid())
  userId          String
  type            String
  key             String
  value           String   @db.Text
  confidence      Float    @default(0.7)
  evidenceCount   Int      @default(1)
  status          String   @default("active") // "active" | "archived"
  sourceCompanion String                      // companion whose consolidator wrote it
  sourceMessageId String?                     // CompanionMessage behind the latest evidence
  provenance      Json?                       // { sources: [...], history: [superseded values] }
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, status])
}

// Inferred recurring behavior. A pattern is an inference from evidence:
// `confidence` is its accumulated strength, and `status` follows from it.
model BehavioralPattern {
  id              String    @id @default(cuid())
  userId          String
  companion       String
  patternType     String
  description     String    @db.Text
  confidence      Float
  evidenceCount   Int       @default(1)
  severity        String    @default("emerging")  // "emerging" | "confirmed" | "critical"
  status          String    @default("emerging")  // "emerging" | "active" | "weakening" | "resolved" | "expired"
  evidence        Json?                           // latest supporting observations + source message ids
  firstObservedAt DateTime  @default(now())
  lastObservedAt  DateTime  @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user MessengerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companion, patternType])
  @@index([userId, status])
}

// One row per Nova user turn whose evidence has to be consolidated.
// It is the retry record: pending → processing → completed, and a failed or
// abandoned attempt goes back to a retryable state. The primary key is the
// turn-level idempotency: a turn can have only one job.
model NovaConsolidationJob {
  messageId   String    @id                 // CompanionMessage.id of the user turn
  userId      String
  status      String    @default("pending") // "pending" | "processing" | "completed" | "failed"
  attempts    Int       @default(0)
  payload     Json?                         // evidence + run context; emptied on completion
  claimedAt   DateTime?                     // start of the current attempt (lease)
  completedAt DateTime?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  message CompanionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

// Telegram webhook idempotency. One row per update_id; the unique key is the
// dedup. A retried or replayed update fails the insert and is dropped.
model ProcessedTelegramUpdate {
  updateId   BigInt   @id
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// ── Nova on Telegram ──────────────────────────────────────────────────────────
// Per-learner state of the Telegram surface. It holds nothing about learning:
// whether Nova may message first, whether the chat can be reached, and the
// counters that bound one chat's load. Owner: nova/telegram/channel-store.ts.
model NovaTelegramChannel {
  profileId            String    @id
  proactiveEnabled     Boolean   @default(true)
  proactivePausedUntil DateTime? // "Not today": no proactive message before this
  undeliverableSince   DateTime? // Telegram refused delivery (bot blocked); cleared by any inbound update
  lastDeliveredAt      DateTime?

  // One free-text turn at a time per chat, across instances and restarts.
  // A lease, not a lock: it expires by itself if the process dies.
  turnLockedUntil      DateTime?

  // Commands and button taps per minute.
  actionWindowStart    DateTime?
  actionCount          Int       @default(0)

  // Model calls today (learner-local day), for the daily budget.
  usageDay             String?
  understandingCalls   Int       @default(0)
  responseCalls        Int       @default(0)

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A message Nova sent that offers choices. Conversation state, not learner
// state: the session, the plan and mastery stay where they are. At most one
// prompt per learner is open; openKey (the profile id while open, null once
// resolved) makes the database hold that. A button carries only the prompt id
// and an option id; what the option does is read from this row.
// Owner: nova/telegram/prompt-store.ts. Resolved rows are purged after 30 days.
model NovaTelegramPrompt {
  id                String    @id @default(cuid())
  profileId         String
  chatId            String
  kind              String
  options           Json      // [{ id, label, action }]
  telegramMessageId Int?
  openKey           String?   @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  resolvedAt        DateTime?
  resolution        Json?     // { by, optionId }

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([resolvedAt])
}

// ─── Nova browser extension ───────────────────────────────────────────────────

// Something the learner explicitly did with a page in their browser: saved
// it, or asked to study it. It is a record of that action and nothing more:
// not a session, not mastery, not memory. Only product/learning-events.ts
// reads or writes it, and it holds no page content: the address, the title
// and where the learner filed it.
model NovaLearningEvent {
  id            String   @id @default(cuid())
  profileId     String
  eventType     String   // "resource_saved" | "selection_saved" | "study_requested"
  source        String   // "browser_extension" | "web": set by the server from the credential used
  // The id the client gave this one action. A retry carries the same id and
  // creates nothing.
  clientEventId String
  url           String   @db.Text
  domain        String
  title         String
  subjectId     String?
  topicName     String?
  occurredAt    DateTime

  // What the page calls its own address (its canonical link), when the
  // extension could read one. Kept beside `url`, never instead of it.
  canonicalUrl  String?  @db.Text
  // The passage the learner selected and sent ("selection_saved" only).
  excerpt       String?  @db.Text
  // Who filed it where it is: "learner", or "nova" for a link Nova made
  // from a name match and the learner has not yet kept or undone.
  filedBy       String?

  // Looking for what this page connects to. The saved row never depends on
  // it: a failure is recorded here and the page stays saved.
  // "none" | "pending" | "processing" | "done" | "failed"
  processingStatus    String    @default("none")
  processingAttempts  Int       @default(0)
  processingStartedAt DateTime?
  processedAt         DateTime?
  processingError     String?
  // What processing found: ResourceConnections (learning-events.types.ts).
  connections         Json?

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject NovaSubject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([profileId, clientEventId])
  @@index([processingStatus, processingStartedAt])
  @@index([profileId, eventType, occurredAt])
  @@index([profileId, subjectId])
}

// A browser the learner connected to their account. It starts as a one-time
// pairing code shown on the web app and becomes a connection when the
// extension redeems the code. Only hashes are stored: neither the code nor
// the extension's credential can be read back from this table. The
// credential opens the extension routes and nothing else, and stops working
// when the row is revoked or goes unused for 30 days.
model NovaExtensionConnection {
  id            String    @id @default(cuid())
  userId        String
  label         String?   // what the extension called itself, so the learner can tell connections apart
  codeHash      String?   @unique
  codeExpiresAt DateTime?
  tokenHash     String?   @unique
  connectedAt   DateTime?
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Nova tasks ───────────────────────────────────────────────────────────────

// Something the learner has decided to do: an assignment, a chapter to revise,
// a form to hand in. It is the learner's own to-do list and nothing more: not
// a study session, not evidence, not mastery, and not an input to the
// Planning Engine. Only product/tasks.ts reads or writes it. The Planner's
// list and its board are two views of these rows.
model NovaTask {
  id          String    @id @default(cuid())
  profileId   String
  subjectId   String?
  topicName   String?
  title       String
  status      String    @default("todo")   // "todo" | "in_progress" | "done"
  priority    String?                      // "low" | "medium" | "high"; null: not set
  // The day it is due, as the learner's own calendar day (YYYY-MM-DD). A day,
  // not an instant: it does not move when a timezone does.
  dueDay      String?
  // Set when the task enters "done", cleared when it leaves.
  completedAt DateTime?
  // How long the learner expects it to take, in minutes. Null: not said.
  estimatedMinutes Int?
  // The learner's own order on their list (ascending). Null: not placed;
  // sorted after placed tasks by the board's usual order.
  position         Int?
  // A key the creator gave this task, unique for the learner. A retried
  // request, a double click or a template applied twice carries the same key
  // and creates nothing.
  clientKey   String?
  // The task this one is a step of. null: a task of its own. Steps nest up
  // to TASK_DEPTH_MAX levels (tasks.types.ts); tasks.ts keeps the tree free
  // of loops. Removing a task removes its steps with it.
  parentId    String?

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subject NovaSubject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  parent  NovaTask?           @relation("NovaTaskSteps", fields: [parentId], references: [id], onDelete: Cascade)
  steps   NovaTask[]          @relation("NovaTaskSteps")
  // What must be finished before this one (NovaTaskDependency), and what waits on it.
  waitsOn NovaTaskDependency[] @relation("NovaTaskWaits")
  blocks  NovaTaskDependency[] @relation("NovaTaskBlocks")

  // Times the learner set aside on the calendar to work on this task. The
  // task stays the one record of the work; an event only schedules it.
  calendarEvents NovaCalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, clientKey])
  @@index([profileId, status])
  @@index([profileId, dueDay])
  @@index([parentId])
}

// A task that cannot start until another is finished: taskId waits on
// dependsOnId. Both are the same learner's tasks (checked by tasks.ts, the
// only writer); never a task on itself, never a loop. Removing either task
// removes the link.
model NovaTaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String

  task      NovaTask @relation("NovaTaskWaits", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn NovaTask @relation("NovaTaskBlocks", fields: [dependsOnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

// ─── Calendar events (product/calendar.ts is the only reader and writer) ─────
// Something at a time or on a day that is not already a task or a dated
// deadline: a class, a meeting, a study block, something personal. Tasks
// (NovaTask.dueDay) and deadlines (NovaExam) are shown on the calendar from
// their own tables and are never copied here.
model NovaCalendarEvent {
  id              String    @id @default(cuid())
  profileId       String
  title           String
  description     String?   @db.Text
  // "class" | "meeting" | "study" | "personal" | "other"
  category        String    @default("other")
  allDay          Boolean   @default(false)
  // The learner's own calendar days (YYYY-MM-DD), first and last, inclusive.
  // Always set: an all-day event is only days; a timed one's are the days
  // its start and end fall on in its timezone. Ranges are read by these.
  startDay        String
  endDay          String
  // A timed event's moments. Null for an all-day event, so a day never
  // shifts when a timezone does.
  startAt         DateTime?
  endAt           DateTime?
  // The IANA zone the times were given in (and an all-day reminder's clock).
  timezone        String
  // Minutes before the start to remind (an all-day event: before 09:00 on
  // its first day). Null: no reminder.
  reminderMinutes Int?
  // When that reminder is due, worked out by the server on every write.
  // The tick sends what is due by this; a moved or removed event leaves no
  // stale time behind, because the occurrence key names this instant.
  remindAt        DateTime?
  // A task this time is set aside for (optional).
  taskId          String?
  subjectId       String?
  // A key the creator gave this event, unique for the learner: a retried
  // create returns the event it made.
  clientKey       String?
  // Repeats: null (once), "daily", "weekly" or "monthly". The days and times
  // above are the first occurrence; the others are worked out from them
  // (product/calendar-rules.ts), never stored one by one. For a repeating
  // event remindAt is the next occurrence's reminder, moved on by the tick.
  repeat          String?
  // Weekly: the weekdays it repeats on, 0 = Sunday … 6 = Saturday.
  repeatDays      Int[]     @default([])
  // The last day an occurrence may start on, inclusive. Null: no end.
  repeatUntil     String?
  // Occurrences the learner removed, by the day each starts on.
  skipDays        String[]  @default([])

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task    NovaTask?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subject NovaSubject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, clientKey])
  @@index([profileId, startDay])
  @@index([profileId, endDay])
  @@index([remindAt])
}

// The learner's changes to one day's computed plan: leave a topic out of
// that day ("skip"), keep it in ("pin"), or put it at a place ("order", with
// position). The Planning Engine still works the day out; these are applied
// to its result for that calendar day only. Never written by a model.
// The learner's own list for one calendar day (product/day-flow.ts, its only
// reader and writer): what they chose to do today, in their order, with
// today's time for each, and Nova's draft for a day that has none yet, kept
// apart until they take it. Items name tasks and topics by id; nothing here
// changes a task, a topic or the roadmap. Additive: one row per learner per day.
model NovaDayFlow {
  id         String   @id @default(cuid())
  profileId  String
  // The learner's calendar day (YYYY-MM-DD).
  day        String
  intention  String?
  // FlowItem[] (day-flow.types.ts). Empty and saved=false: no flow made yet.
  items      Json
  saved      Boolean  @default(false)
  // FlowDraft or null.
  draft      Json?
  // "list" | "schedule".
  view       String   @default("list")
  // Earlier states for Undo, newest last (FLOW_UNDO_MAX).
  history    Json?
  // Every change is made only against the version it was read at.
  version    Int      @default(1)
  profile    NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([profileId, day])
}

model NovaPlanOverride {
  id        String   @id @default(cuid())
  profileId String
  // The learner's calendar day (YYYY-MM-DD) it applies to.
  day       String
  kind      String   // "skip" | "pin" | "order"
  topicId   String
  position  Int?     // "order" only
  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topic   NovaTopicMastery    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One override of each kind per topic per day: a repeat is an upsert.
  @@unique([profileId, day, kind, topicId])
  @@index([profileId, day])
}

// Where the learner put an item on their Knowledge Map. Only the position:
// what the item is, and how it is connected, stays with the item's own row
// and is read by the map's read model. A node with no row here is placed by
// the map's own layout. Written only by product/map-layout.ts.
model NovaMapLayout {
  id        String   @id @default(cuid())
  profileId String
  // The map's kind of item and that item's row id: "subject" | "topic" |
  // "note" | "resource". Ids of different kinds never meet: the pair is the key.
  nodeType  String
  nodeId    String
  x         Float
  y         Float

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, nodeType, nodeId])
}

//////////////////////////////////////////////////
// BILLING
//////////////////////////////////////////////////
// What an account has paid for, its free trial, the payment provider's
// webhook deliveries and AI usage. The provider is the authority on a paid
// subscription: rows here are written only from verified webhook events (or
// a fetch of the provider's own record), never from a browser. No card or
// payment details are stored. Written only by packages/api/src/billing.

// The account's subscription with the payment provider, as the provider last
// reported it. One per account: a new purchase replaces the row's provider ids.
model BillingSubscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  provider               String // "polar"
  providerCustomerId     String?
  providerSubscriptionId String    @unique
  planKey                String // "pro_monthly" | "pro_annual" (billing/plans.ts)
  // The provider's status: trialing | active | past_due | unpaid | canceled |
  // incomplete | incomplete_expired | paused, or "revoked" once access ended.
  status                 String
  currency               String?
  billingInterval        String? // "month" | "year"
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  canceledAt             DateTime?
  endedAt                DateTime?
  pastDueAt              DateTime?
  // The provider's own last-modified time of the record applied here. An
  // event about an older version is ignored, so late deliveries cannot undo
  // newer state.
  providerModifiedAt     DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Kio's own free trial: Pro for a few days, no card, no automatic charge.
// One per account, ever: the row is the eligibility record, so logging out,
// a new session or a changed clock cannot start a second one.
model BillingTrial {
  userId    String   @id
  planKey   String // the plan the trial gives the access of
  startedAt DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Every webhook delivery, by the provider's event id: a repeat of an id
// already processed is acknowledged and not applied again.
model BillingWebhookEvent {
  id          String    @id // the provider's webhook-id
  provider    String
  type        String
  status      String // received | processed | ignored | failed
  error       String?
  attempts    Int       @default(1)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
}

// AI use per account (or per learner with no web account) per UTC day: the
// meter the daily allowances are checked against, and the record behind cost
// per active user. Requests are counted when allowed; tokens are added when
// the model reports them.
model AiUsageDay {
  subjectKey   String // "user:<id>" or "learner:<platformChatId>"
  day          String // YYYY-MM-DD, UTC
  requests     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([subjectKey, day])
  @@index([day])
}

// A workspace made from a template or by Nova (packages/api/src/nova/product/
// workspaces.ts, its only reader and writer). It owns no learning data: its
// subjects, topics, dates, tasks and notes live in their own tables, made by
// their own writers in one transaction, and this row records what was made
// and from what. Deleting it deletes none of them.
model NovaWorkspace {
  id              String   @id @default(cuid())
  profileId       String
  // "template": a Kio template, personalised. "custom": generated by Nova.
  kind            String
  templateId      String?
  templateVersion Int?
  title           String
  summary         String?  @db.Text
  // The plan as created (product/workspace-plan.ts), for showing it back.
  plan            Json
  // Files the plan was made from: names and what was read, never content.
  sources         Json?
  // The learner's subjects it made or added to.
  subjectIds      String[]
  // One creation, however many times the request is sent.
  clientKey       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, clientKey])
  @@index([profileId, createdAt])
}

// ─── Build with Nova: one conversation and its proposal (product/builder.ts) ─
// The only reader and writer is product/builder.ts. A draft is a
// conversation with Nova and the plan it proposes; it owns no learning data.
// Nothing in it is a task, topic, note or date: approving a version builds
// those through their own writers (workspaces.ts), and the draft then points
// at the workspace it made.
model NovaWorkspaceDraft {
  id                String   @id @default(cuid())
  profileId         String
  // discovery | drafting | awaiting_approval | building | ready | failed | cancelled
  status            String   @default("discovery")
  // Where the conversation began: "web" or "telegram".
  origin            String   @default("web")
  title             String?
  // The conversation: [{ id, role: "user" | "nova", text, at, kind? }], capped.
  messages          Json
  // What Nova has understood: the learner's facts, its assumptions and
  // recommendations, the open question (product/builder-state.ts).
  brief             Json
  // The proposed WorkspacePlan, checked; null until one is drafted.
  plan              Json?
  // Bumped by every change to the plan, Nova's or the learner's. Approval
  // names the version it approves.
  version           Int      @default(0)
  // A model job in progress: { kind, stage, startedAt, baseVersion }.
  pending           Json?
  // The job's id. A job writes its result only while this is still its id,
  // so a cancelled or superseded job changes nothing.
  jobId             String?
  // Why the last step failed, in words, and which step: { stage, message }.
  failure           Json?
  // What of theirs this conversation works on, when it is something they
  // already have: a workspace, or subjects that belong to none. Found from
  // their words (builder.ts resolves the name among their own records), given
  // by "Improve with Nova", or the workspace this conversation built.
  targetWorkspaceId String?
  targetSubjectIds  String[] @default([])
  // The proposed change set for that existing resource: checked operations
  // on its records by id ({ ops, dropped }). Applied only on approval, through
  // each record's own writer. Empty ({}) when there is none.
  changes           Json?
  // The workspace approval made or added to.
  workspaceId       String?
  // The version that was built.
  builtVersion      Int?
  // One draft per start, however many times the request is sent.
  clientKey         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile NovaAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  files   NovaWorkspaceDraftFile[]
  history NovaWorkspaceDraftVersion[]

  @@unique([profileId, clientKey])
  @@index([profileId, updatedAt])
}

// One version of what a Build with Nova conversation proposed or built, kept
// so the learner can look back at it and restore it (product/builder-history.ts).
// Restoring never removes a version: it makes a new one.
model NovaWorkspaceDraftVersion {
  id        String   @id @default(cuid())
  draftId   String
  profileId String
  // The draft's version number this records.
  version   Int
  // proposal: a plan, or { changes, title }. built: the records as they
  // stood after it was built or applied (builder-history.ts Snapshot).
  kind      String
  // nova | you | restored
  author    String
  // What it changed, in words, for the list.
  summary   String   @db.Text
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft NovaWorkspaceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, version, kind])
  @@index([draftId, createdAt])
}

// A PDF or photo the learner shared in a Build with Nova conversation, so
// Nova can read it on later messages and when it writes the proposal. Only
// product/builder.ts reads or writes it. Deleted when the conversation is
// built or cancelled; removed with the draft.
model NovaWorkspaceDraftFile {
  id        String   @id @default(cuid())
  draftId   String
  name      String
  // Read from the bytes on upload, never the browser's word.
  mimeType  String
  bytes     Bytes
  size      Int
  // A PDF's page count when it states one.
  pages     Int?
  createdAt DateTime @default(now())

  draft NovaWorkspaceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}
