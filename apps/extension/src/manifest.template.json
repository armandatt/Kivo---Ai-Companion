{
  "manifest_version": 3,
  "name": "Nova",
  "version": "1.1.0",
  "description": "Save a page or passage to Nova, study it, or ask about a diagram with a screenshot. Nova sees a page only when you click its button.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Nova",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "permissions": ["activeTab", "scripting", "storage"]
}
