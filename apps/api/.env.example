# The API's environment. Copy to .env for local work; on Render, set these in
# the service's Environment. Never commit real values.

DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=a-long-random-string-shared-exactly-with-the-web-app
# Where the web app is: every link and redirect the API makes back to it (the
# Google sign-in return, auth emails, checkout and portal returns, Telegram's
# "open Kivo" link). The production web app is the Vercel project
# kivo-ai-companion-web-kar8. GOOGLE_REDIRECT_URI must be on the same host:
# the sign-in cookie is set on the callback's host, so a callback on another
# host signs people in there instead. Register the callback in Google Cloud
# Console before changing it here.
NEXT_PUBLIC_APP_URL=https://kivo-ai-companion-web-kar8.vercel.app
GOOGLE_REDIRECT_URI=https://kivo-ai-companion-web-kar8.vercel.app/api/auth/google/callback

# ── Billing (packages/api/src/billing, docs/BILLING.md) ──────────────────────
# Polar. Sandbox and production have separate tokens, secrets and product ids:
# set POLAR_SERVER to match the token. Leave the block empty to run without
# payments (Free and trials still work; checkout says payments open soon).
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_ANNUAL=
# The yearly plan is not sold until this is "true".
BILLING_ANNUAL_ENABLED=false
# Kivo's own no-card trial (days) and the grace after a failed payment (days).
BILLING_TRIAL_DAYS=7
BILLING_GRACE_DAYS=3
# Daily AI requests per account, across web, Telegram and the extension.
BILLING_FREE_DAILY_AI=150
BILLING_PRO_DAILY_AI=600
